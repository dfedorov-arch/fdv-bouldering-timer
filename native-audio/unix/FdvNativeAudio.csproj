<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);FDV_UNIX_AUDIO</DefineConstants>
    <AssemblyName>fdv-audio-player</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLayer" Version="[3.0.0]" />
    <Compile Include="../../lib/server-audio-player.cs" Link="Player.cs" />
    <Compile Include="../../test/helpers/native-audio-render.cs" Link="NativeRenderChecks.cs" Condition="'$(AudioSelfTest)' == 'true'" />
    <Compile Include="../../launcher/unix/LauncherBuildInfo.cs" Link="LauncherBuildInfo.cs" Condition="'$(AudioSelfTest)' == 'true'" />
  </ItemGroup>
  <PropertyGroup Condition="'$(AudioSelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);FDV_AUDIO_SELF_TEST</DefineConstants>
  </PropertyGroup>
</Project>
