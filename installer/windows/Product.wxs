<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="FDV Bouldering Timer"
      Manufacturer="FDV"
      Version="$(var.Version)"
      UpgradeCode="B72ED423-6973-467C-8AB5-7F85D90CF8D9"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of FDV Bouldering Timer is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FDV Bouldering Timer" />
    </StandardDirectory>
    <Feature Id="MainFeature" Title="FDV Bouldering Timer" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
    </Feature>
  </Package>
</Wix>
