<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="$(var.InstallerName)"
      Manufacturer="FDV"
      Version="$(var.Version)"
      Codepage="$(var.InstallerCodepage)"
      UpgradeCode="$(var.InstallerUpgradeCode)"
      InstallerVersion="500"
      Scope="perMachine">
    <?if $(var.LegacyPackage) = true ?>
    <SummaryInformation Codepage="1251" />
    <Launch Condition="Installed OR (VersionNT &gt;= 601 AND (VersionNT &gt; 601 OR ServicePackLevel &gt;= 1))"
            Message="Requires Windows 7 SP1 / Windows 8 or later." />
    <?endif?>
    <MajorUpgrade DowngradeErrorMessage="A newer version of FDV Bouldering Timer is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="$(var.InstallerProgramFiles)">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallerFolder)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="FDVStartMenuFolder" Name="$(var.InstallerName)" />
    </StandardDirectory>
    <Property Id="CREATE_START_MENU_SHORTCUT" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Component Id="InstalledPackageMarker" Directory="INSTALLFOLDER" Guid="*">
      <File Id="InstalledMarkerFile" Source="$(sys.SOURCEFILEDIR)..\common\fdv-installed.marker"
            Name="fdv-installed.marker" KeyPath="yes" />
    </Component>
    <?if $(var.LegacyPackage) = true ?>
    <Component Id="InstalledMsiReadmeComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="InstalledMsiReadme" Source="$(sys.SOURCEFILEDIR)ReadMe-legacy-msi.txt"
            Name="ReadMe-MSI.txt" KeyPath="yes" />
    </Component>
    <?endif?>
    <Component Id="StartMenuShortcut" Directory="FDVStartMenuFolder" Guid="*"
               Condition="CREATE_START_MENU_SHORTCUT">
      <Shortcut Id="StartTimer" Name="$(var.InstallerName)"
                Target="[INSTALLFOLDER]fdv-bouldering-timer.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveFDVStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="$(var.InstallerRegistryKey)"
                     Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*"
               Condition="CREATE_DESKTOP_SHORTCUT">
      <Shortcut Id="DesktopTimer" Name="$(var.InstallerName)"
                Target="[INSTALLFOLDER]fdv-bouldering-timer.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="$(var.InstallerRegistryKey)"
                     Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <UIRef Id="InstallDir_NoLicense" />
    <UI>
      <Dialog Id="ShortcutOptionsDlg" Width="370" Height="270" Title="Параметры ярлыков">
        <Control Id="Title" Type="Text" X="20" Y="18" Width="330" Height="22"
                 Text="Выберите ярлыки для таймера" />
        <Control Id="Description" Type="Text" X="20" Y="50" Width="330" Height="30"
                 Text="Ярлыки можно удалить позднее обычными средствами Windows." />
        <Control Id="StartMenu" Type="CheckBox" X="25" Y="100" Width="300" Height="18"
                 Property="CREATE_START_MENU_SHORTCUT" CheckBoxValue="1"
                 Text="Создать ярлык в меню «Пуск»" />
        <Control Id="Desktop" Type="CheckBox" X="25" Y="128" Width="300" Height="18"
                 Property="CREATE_DESKTOP_SHORTCUT" CheckBoxValue="1"
                 Text="Создать ярлык на рабочем столе" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="Назад">
          <Publish Event="NewDialog" Value="InstallDirDlg" Condition="1" />
        </Control>
        <Control Id="Next" Type="PushButton" X="240" Y="243" Width="56" Height="17"
                 Default="yes" Text="Далее">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="300" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Отмена">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
    </UI>
    <Feature Id="MainFeature" Title="$(var.InstallerName)" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstalledPackageMarker" />
      <?if $(var.LegacyPackage) = true ?>
      <ComponentRef Id="InstalledMsiReadmeComponent" />
      <?endif?>
    </Feature>
  </Package>
</Wix>
